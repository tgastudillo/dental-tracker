# Copia este archivo como "secrets.toml" (en la misma carpeta .streamlit/)
# y completa los valores con las credenciales de tu cuenta de servicio de Google.
#
# Cómo obtenerlas:
# 1. Crea un proyecto en https://console.cloud.google.com/
# 2. Habilita las APIs "Google Sheets API" y "Google Drive API"
# 3. Crea una cuenta de servicio (IAM & Admin > Service Accounts) y genera una
#    clave JSON.
# 4. Comparte tu Google Sheet "DentalTracker" con el email de la cuenta de
#    servicio (campo client_email de abajo), con permiso de Editor.
# 5. Copia los valores del JSON descargado en los campos correspondientes.

[gcp_service_account]
type = "service_account"
project_id = "tu-proyecto-id"
private_key_id = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
private_key = "-----BEGIN PRIVATE KEY-----\nTU_CLAVE_PRIVADA_AQUI\n-----END PRIVATE KEY-----\n"
client_email = "nombre-cuenta@tu-proyecto-id.iam.gserviceaccount.com"
client_id = "000000000000000000000"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/nombre-cuenta%40tu-proyecto-id.iam.gserviceaccount.com"
universe_domain = "googleapis.com"
